---
import Topbar from "@/components/Topbar.astro";
import { messages } from "@/lib/i18n";
const t = messages[Astro.locals.locale];
const { user } = Astro.locals;
---

<div class="bg-cosmic min-h-screen p-4 sm:p-8">
  <Topbar />
  <main class="mx-auto max-w-2xl px-4 py-16 text-center sm:py-24">
    <h1 class="mb-6 bg-gradient-to-r from-blue-200 via-purple-200 to-pink-200 bg-clip-text text-4xl font-bold text-transparent sm:text-6xl">
      MedLab Timeline
    </h1>
    <p class="mb-8 text-lg text-blue-100/80">{t.homeDescription}</p>
    <section class="mb-8 rounded-xl border border-white/10 bg-white/5 p-6 text-left">
      <h2 class="mb-2 text-xl font-semibold text-white">{t.patientProfile}</h2>
      <p class="leading-relaxed text-blue-100/70">{t.homeProfileDescription}</p>
    </section>
    <div class="flex flex-col justify-center gap-4 sm:flex-row">
      {user ? (
        <a
          href="/dashboard"
          class="rounded-lg bg-purple-600 px-6 py-3 font-medium text-white transition-colors hover:bg-purple-500"
        >
          {t.openDashboard}
        </a>
      ) : (
        <>
          <a
            href="/auth/signin"
            class="rounded-lg bg-purple-600 px-6 py-3 font-medium text-white transition-colors hover:bg-purple-500"
          >
            {t.signIn}
          </a>
          <a
            href="/auth/signup"
            class="rounded-lg border border-white/20 px-6 py-3 font-medium text-white transition-colors hover:bg-white/10"
          >
            {t.signUp}
          </a>
        </>
      )}
    </div>
  </main>
</div>
