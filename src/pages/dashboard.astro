---
import Layout from "@/layouts/Layout.astro";
import { messages } from "@/lib/i18n";
import { createClient } from "@/lib/supabase";
import { patientColumns, utcToday, type Patient } from "@/lib/patient-profile";
import PatientProfile from "@/components/patient/PatientProfile";
import { buttonVariants } from "@/components/ui/button";

const { user } = Astro.locals;
const t = messages[Astro.locals.locale];
Astro.response.headers.set("Cache-Control", "private, no-store");
let patient: Patient | null = null;
let loadFailed: boolean;
try {
  const supabase = createClient(Astro.request.headers, Astro.cookies);
  if (!supabase || !user) {
    loadFailed = true;
  } else {
    const { data, error } = await supabase
      .from("patients")
      .select(patientColumns)
      .eq("owner_id", user.id)
      .maybeSingle<Patient>();
    loadFailed = Boolean(error);
    patient = data;
  }
} catch {
  loadFailed = true;
}
---

<Layout title={t.dashboard}>
  <main class="dashboard-theme dark min-h-screen bg-background px-4 py-8 text-foreground sm:py-12">
    <div class="mx-auto w-full max-w-2xl space-y-5">
      <div>
        <a href="/" class:list={buttonVariants({ variant: "ghost", size: "sm" })}>
          <span aria-hidden="true">← </span>
          {t.home}
        </a>
      </div>
      <div class="space-y-8 rounded-xl border border-border bg-card p-6 text-card-foreground shadow-sm sm:p-8">
        <header class="space-y-3 border-b border-border pb-6">
          <h1 class="text-3xl font-semibold tracking-tight">{t.dashboard}</h1>
          <p class="break-words text-sm text-muted-foreground">
            {t.welcome} <span class="font-medium text-foreground">{user?.email}</span>
          </p>
        </header>
        {loadFailed ? (
          <p role="alert" class="text-destructive">
            {t.profileLoadFailed}
          </p>
        ) : (
          <div>
            <PatientProfile
              client:load
              patient={patient}
              messages={t}
              today={utcToday()}
              locale={Astro.locals.locale}
            />
          </div>
        )}
        <form method="POST" action="/api/auth/signout" class="border-t border-border pt-6">
          <button type="submit" class:list={buttonVariants({ variant: "secondary", size: "sm" })}>
            {t.signOut}
          </button>
        </form>
      </div>
    </div>
  </main>
</Layout>
