---
import Layout from "@/layouts/Layout.astro";
import { messages } from "@/lib/i18n";
import { createClient } from "@/lib/supabase";
import { patientColumns, utcToday, type Patient } from "@/lib/patient-profile";
import PatientProfile from "@/components/patient/PatientProfile";

const { user } = Astro.locals;
const t = messages[Astro.locals.locale];
Astro.response.headers.set("Cache-Control", "private, no-store");
let patient: Patient | null = null;
let loadFailed: boolean;
try {
  const supabase = createClient(Astro.request.headers, Astro.cookies);
  if (!supabase || !user) {
    loadFailed = true;
  } else {
    const { data, error } = await supabase
      .from("patients")
      .select(patientColumns)
      .eq("owner_id", user.id)
      .maybeSingle<Patient>();
    loadFailed = Boolean(error);
    patient = data;
  }
} catch {
  loadFailed = true;
}
---

<Layout title={t.dashboard}>
  <div class="bg-cosmic flex min-h-screen items-center justify-center p-4">
    <div class="w-full max-w-xl rounded-2xl border border-white/10 bg-white/10 p-8 text-center text-white backdrop-blur-xl">
      <div class="mb-6 text-left">
        <a href="/" class="text-sm text-purple-200 hover:text-white hover:underline">
          <span aria-hidden="true">← </span>
          {t.home}
        </a>
      </div>
      <h1 class="mb-4 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-3xl font-bold text-transparent">
        {t.dashboard}
      </h1>
      <p class="text-blue-100/80">
        {t.welcome} <span class="font-semibold text-white">{user?.email}</span>
      </p>
      {loadFailed ? (
        <p role="alert" class="mt-6 text-red-300">
          {t.profileLoadFailed}
        </p>
      ) : (
        <PatientProfile client:load patient={patient} messages={t} today={utcToday()} locale={Astro.locals.locale} />
      )}
      <form method="POST" action="/api/auth/signout" class="mt-3">
        <button
          type="submit"
          class="rounded-lg border border-white/20 bg-white/10 px-4 py-2 text-sm transition-colors hover:bg-white/20"
        >
          {t.signOut}
        </button>
      </form>
    </div>
  </div>
</Layout>
