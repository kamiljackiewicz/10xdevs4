---
import Layout from "@/layouts/Layout.astro";
import SignInForm from "@/components/auth/SignInForm";
import { authErrorMessage, messages } from "@/lib/i18n";

const t = messages[Astro.locals.locale];
const error = authErrorMessage(Astro.url.searchParams.get("error"), Astro.locals.locale);
---

<Layout title={t.signIn}>
  <div class="bg-cosmic flex min-h-screen items-center justify-center p-4">
    <div class="w-full max-w-sm rounded-2xl border border-white/10 bg-white/10 p-8 text-white backdrop-blur-xl">
      <h1 class="mb-6 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-center text-2xl font-bold text-transparent">
        {t.signIn}
      </h1>
      <SignInForm messages={t} serverError={error} client:load />
      <p class="mt-4 text-center text-sm text-blue-100/60">
        {t.noAccount}{" "}
        <a href="/auth/signup" class="text-purple-300 hover:underline">
          {t.signUp}
        </a>
      </p>
    </div>
  </div>
</Layout>
