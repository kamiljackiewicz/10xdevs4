{
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/scripts/agent-hooks/run.mjs\" edit",
            "timeout": 30
          }
        ],
        "matcher": "^apply_patch$"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/scripts/agent-hooks/run.mjs\" stop",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
